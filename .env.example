# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the anon key (legacy) or the publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the website (used for SEO, sitemap and password-reset links)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional, server only: lets the owner create team accounts from Dashboard → Team.
# Service role key (legacy) or secret key (sb_secret_…). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email the team when a customer sends a trade-in enquiry, reservation,
# question or contact message (https://resend.com — free tier is enough).
# NOTIFY_EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_FROM="iZone <alerts@your-domain.com>"
